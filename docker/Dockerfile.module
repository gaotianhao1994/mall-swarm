# ============================================================
#  mall-swarm 微服务模块通用 Dockerfile
#
#  架构设计：
#    context = 项目根目录（"."）
#    Maven 在 Step 3 已构建好所有 JAR，散落在各模块 target/ 下
#    本文件通过 ARG 接收 JAR 的相对路径，直接复制到运行镜像
#
#  调用方式（来自 docker-build.yml）：
#    context: .
#    file: ./docker/Dockerfile.module
#    build-arg: JAR_PATH=mall-gateway/target/mall-gateway-1.0-SNAPSHOT.jar
# ============================================================

FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="mall-swarm"
LABEL description="mall-swarm microservice module"

RUN apk add --no-cache curl && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app

# JAR_PATH 是相对于项目根目录的路径，如 mall-gateway/target/mall-gateway-1.0-SNAPSHOT.jar
ARG JAR_PATH
COPY ${JAR_PATH} ./app.jar

ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar app.jar"]
