# ============================================================
#  mall-swarm 环境变量配置
#  复制此文件为 .env 并修改其中的值
#  注意：不要将填写了真实密码的 .env 文件提交到 Git！
# ============================================================

# ---------- ACR 镜像仓库配置 ----------
ACR_REGISTRY=<your-acr-registry>.cn-guangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=mall-swarm-202606

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_PORT=3306

# ---------- Redis 配置 ----------
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# ---------- Nacos 配置 ----------
NACOS_PORT=8848
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789

# ---------- 应用服务端口 ----------
GATEWAY_PORT=8201
ADMIN_PORT=8080
AUTH_PORT=8401

# ---------- 目录配置 ----------
DATA_DIR=/root/projects/mall-swarm/data
LOG_DIR=/root/projects/mall-swarm/logs
